setcpm(124 / 4)

// --- VOCAL SAMPLES & EFFECTS ---

// 1. Chopped & pitched rhythmic vocal hook for the drops
const vocalChop = s("speech:0 speech:2 speech:4 speech:1")
  .struct("~ x ~ x ~ [x x] ~ x") // Syncopated house rhythm
  .speed(1.25)                    // Pitches the voice up slightly for a classic house feel
  .cut(1)                         // Stops previous vocal slice when a new one triggers
  .lpf(2800)                      // Tames harsh high frequencies
  .delay(0.375)                   // Dotted-eighth echo
  .delayfeedback(0.4)
  .room(0.5)
  .gain(0.85)

// 2. Spoken/atmospheric vocal phrase for the build-up and breakdown
const vocalPhrase = s("ade:2")
  .slow(4)                        // Lets the longer sample breathe over 4 bars
  .speed(0.95)                    // Slightly deeper, moody vocal tone
  .room(0.85)                     // Large hall reverb
  .size(0.9)
  .delay(0.5)
  .gain(0.8)

// --- INDIVIDUAL INSTRUMENTS ---

const kick = s("bd*4")

const percussion = stack(
  s("~ cp ~ cp"),
  s("~ oh ~ oh ~ oh ~ oh").gain(0.7),
  s("hh*16").gain(perlin.range(0.1, 0.35))
)

const bass = note("c2 ~ c2 g1 ~ a1 ~ g1")
  .s("sawtooth")
  .lpf(450)
  .resonance(4)

const chords = note("<[c4,eb4,g4,bb4] [f4,ab4,c5,eb5]>")
  .struct("~ [x ~ x] ~ ~")
  .s("piano")
  .delay(0.25)
  .room(0.4)

// --- SONG SECTIONS ---

// 1. Intro: Filtered chords and minimal percussion (4 bars)
const intro = stack(
  percussion.lpf(1200),
  chords.lpf(600)
)

// 2. Build-up: Atmospheric vocal + rising snare roll & filter sweep (4 bars)
const buildSection = stack(
  vocalPhrase,
  s("cp*8").gain(saw.range(0.2, 0.9).slow(4)),
  chords.lpf(saw.range(300, 4000).slow(4)),
  bass.lpf(250)
)

// 3. Drop: Full beat, bass, bright chords, and chopped vocal hook (8 bars)
const drop = stack(
  kick,
  percussion,
  bass,
  chords,
  vocalChop
)

// 4. Breakdown: Drums drop out; atmospheric vocal + melodic synth (4 bars)
const breakdown = stack(
  vocalPhrase,
  chords.room(0.8),
  note("g4 ~ eb4 c4 ~ d4 eb4 g4")
    .s("triangle")
    .delay(0.375)
    .gain(0.4)
)

// --- FULL ARRANGEMENT (28 Bars Total) ---
arrange(
  [4, intro],
  [4, buildSection],
  [8, drop],
  [4, breakdown],
  [8, drop]
)
