// Original: slow orbit
setcpm(60/4);
const drums = stack(s("bd ~ ~ ~"), s("hh*4").gain(.22).pan(.65), s("~ ~ cp ~").gain(.5));
const bass = note("eb2 ~ bb2 ~").s("sine").lpf(700).gain(.45).release(.12);
const pad = note("[eb4,g4,bb4] [db4,f4,ab4]").s("triangle").slow(4).gain(.23).room(.8).release(2);
const lead = note("<eb2 ~>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(.18).delay(.3);
arrange([4, drums], [8, stack(drums,bass)], [16, stack(drums,bass,pad,lead)], [4, stack(pad,lead)])
