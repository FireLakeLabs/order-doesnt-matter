// Original: blue hour
setcpm(72/4);
const drums = stack(s("bd ~ ~ bd"), s("hh*8").gain(.22).pan(.65), s("~ cp ~ ~").gain(.5));
const bass = note("bb1 f2 ab2 c3").s("sine").lpf(700).gain(.45).release(.12);
const pad = note("[bb3,db4,f4] [ab3,c4,eb4]").s("triangle").slow(4).gain(.23).release(.8).room(.6);
const lead = note("<bb1 c3>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(.18).delay(.3);
arrange([4, drums], [8, stack(drums,bass)], [16, stack(drums,bass,pad,lead)], [4, stack(pad,lead)])
