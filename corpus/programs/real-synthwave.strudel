setcpm(100 / 4)

stack(
  // 80s driving drum beat
  s("bd ~ bd ~"),
  s("~ sd ~ sd").room(0.8).size(0.9),
  s("hh*8").gain(0.5),
  // Chugging 8th-note analog bassline
  note("<a1*8 f1*8 c2*8 g1*8>")
    .s("sawtooth")
    .lpf(800),
  // Retro nostalgic lead melody
  note("e4 ~ g4 a4 ~ g4 e4 d4")
    .s("square")
    .lpf(2000)
    .delay(0.25)
    .gain(0.5)
)
