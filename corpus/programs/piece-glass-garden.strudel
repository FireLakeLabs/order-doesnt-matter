// Original: glass garden
setcpm(96/4);
const drums = stack(s("bd ~ bd ~"), s("hh*8").gain(.22).pan(.65), s("~ cp ~ cp").gain(.5));
const bass = note("b1 fs2 a2 d2").s("sine").lpf(700).gain(.45).release(.12);
const pad = note("[b3,d4,fs4] [a3,cs4,e4]").s("triangle").slow(4).gain(.23).FX(phaser(.3),delay(.2)).room(.5);
const lead = note("<b1 d2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(.18).delay(.3);
arrange([4, drums], [8, stack(drums,bass)], [16, stack(drums,bass,pad,lead)], [4, stack(pad,lead)])
