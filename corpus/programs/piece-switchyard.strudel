// Original: switchyard
setcpm(142/4);
const drums = stack(s("bd*4"), s("hh*16").gain(.22).pan(.65), s("~ cp ~ cp").gain(.5));
const bass = note("g1 g2 bb1 d2").s("sawtooth").lpf(700).gain(.45).release(.12);
const pad = note("[g3,bb3,d4] [eb3,g3,bb3]").s("triangle").slow(4).gain(.23).FX(coarse(3),bpf(1200),distort(.4));
const lead = note("<g1 d2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(.18).delay(.3);
arrange([4, drums], [8, stack(drums,bass)], [16, stack(drums,bass,pad,lead)], [4, stack(pad,lead)])
