// Original: kiln
setcpm(132/4);
const drums = stack(s("bd*4"), s("hh*16").gain(.22).pan(.65), s("~ cp ~ cp").gain(.5));
const bass = note("fs2 fs2 a2 cs3").s("triangle").lpf(700).gain(.45).release(.12);
const pad = note("[fs3,a3,cs4] [e3,g3,b3]").s("triangle").slow(4).gain(.23).room(.3).delay(.2);
const lead = note("<fs2 cs3>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(.18).delay(.3);
arrange([4, drums], [8, stack(drums,bass)], [16, stack(drums,bass,pad,lead)], [4, stack(pad,lead)])
