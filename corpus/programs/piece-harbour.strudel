// Original: harbour
setcpm(90/4);
const drums = stack(s("bd ~ bd ~"), s("hh*8").gain(.22).pan(.65), s("cp ~ cp ~").gain(.5));
const bass = note("c2 ~ g2 bb2").s("triangle").lpf(700).gain(.45).release(.12);
const pad = note("[c4,eb4,g4] [bb3,d4,f4]").s("triangle").slow(4).gain(.23).delay(.3).delaytime(.375);
const lead = note("<c2 bb2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(.18).delay(.3);
arrange([4, drums], [8, stack(drums,bass)], [16, stack(drums,bass,pad,lead)], [4, stack(pad,lead)])
