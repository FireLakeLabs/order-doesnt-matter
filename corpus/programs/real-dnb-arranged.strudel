setcpm(174 / 4)

// --- VOCAL SAMPLES & EFFECTS ---

// 1. Pitched-down atmospheric vocal phrase for the intro & breakdown
const vocalIntro = s("ade:1")
  .slow(4)
  .speed(0.85)                    // Lower pitch for a darker, weightier DnB vibe
  .lpf(2200)
  .room(0.9)
  .size(0.95)
  .delay(0.375)
  .gain(0.8)

// 2. Rapid-fire, chopped ragga/jungle-style vocal stabs for the drop
const vocalStab = s("speech:3 speech:1 speech:5")
  .struct("~ ~ ~ x ~ x ~ [x x]")  // Syncopated off-beat stabs
  .speed(1.15)
  .cut(1)
  .delay(0.25)
  .delayfeedback(0.55)            // Dub-style echoing tail
  .room(0.4)
  .gain(0.75)

// --- DRUMS & PERCUSSION ---

// Classic syncopated 2-step DnB beat
const dnbDrums = stack(
  s("bd ~ ~ ~ ~ bd ~ ~").shape(0.35),
  s("~ ~ sd ~ ~ ~ sd ~").room(0.25).gain(0.95),
  s("hh*8").gain(perlin.range(0.4, 0.75)),
  s("~ ~ ~ hh ~ ~ hh ~").s("oh").gain(0.4) // Ghost snare/hat shuffle
)

// High-passed filtered breakbeat for the intro and build-up
const filteredDrums = dnbDrums
  .hpf(saw.range(1200, 300).slow(4))
  .gain(0.7)

// --- BASS & SYNTHS ---

// Gritty, growling Reese bassline
const reeseBass = note("<c1 ~ [eb1 d1] ~ f1 ~ [g1 bb1] ~>")
  .s("sawtooth")
  .lpf(sine.range(180, 650).slow(2)) // Slow filter movement
  .resonance(6)
  .shape(0.55)                       // Warm saturation/distortion
  .gain(0.95)

// Dark, eerie minor pad
const darkPad = note("<[c3,eb3,g3,d4] [ab2,eb3,g3,c4]>")
  .slow(2)
  .s("supersaw")
  .lpf(900)
  .attack(0.5)
  .release(1.5)
  .room(0.8)
  .gain(0.45)

// --- SONG SECTIONS ---

// 1. Intro: Atmospheric pad, deep vocal, and high-passed drums (4 bars)
const intro = stack(
  darkPad,
  vocalIntro,
  filteredDrums.hpf(1500)
)

// 2. Build-up: Snare roll accelerates while filter opens up (4 bars)
const buildSection = stack(
  darkPad,
  vocalIntro,
  s("sd*8").gain(saw.range(0.2, 0.9).slow(4)),
  reeseBass.lpf(saw.range(100, 300).slow(4))
)

// 3. Drop: Full-weight 174 BPM drums, sub/Reese bass, and dub vocal stabs (8 bars)
const drop = stack(
  dnbDrums,
  reeseBass,
  darkPad.lpf(600),
  vocalStab
)

// 4. Breakdown: Drums cut out completely; spacious pads and vocal take over (4 bars)
const breakdown = stack(
  darkPad.lpf(1400),
  vocalIntro,
  note("g4 ~ eb4 ~ d4 ~ c4 ~")
    .s("triangle")
    .delay(0.5)
    .room(0.9)
    .gain(0.35)
)

// --- FULL ARRANGEMENT (28 Bars Total) ---
arrange(
  [4, intro],
  [4, buildSection],
  [8, drop],
  [4, breakdown],
  [8, drop]
)
