setcpm(31);
const vocalPhrase = (/*@odm-pattern {"label":"vocalPhrase","comment":"2. Spoken/atmospheric vocal phrase for the build-up and breakdown"}*/ s("ade:2").slow(4).speed(0.95).room(0.85).roomsize(0.9).delay(0.5).gain(0.8));
const percussion = (/*@odm-pattern {"label":"percussion"}*/ stack(s("~ cp ~ cp"), s("~ oh ~ oh ~ oh ~ oh").gain(0.7), s("hh*16").gain(perlin.range(0.1, 0.35))));
const bass = (/*@odm-pattern {"label":"bass"}*/ note("c2 ~ c2 g1 ~ a1 ~ g1").s("sawtooth").cutoff(450).resonance(4));
const chords = (/*@odm-pattern {"label":"chords"}*/ note("<[c4,eb4,g4,bb4] [f4,ab4,c5,eb5]>").struct("~ [x ~ x] ~ ~").s("piano").delay(0.25).room(0.4));
const drop = (/*@odm-pattern {"label":"drop","comment":"3. Drop: Full beat, bass, bright chords, and chopped vocal hook (8 bars)"}*/ stack((/*@odm-pattern {"label":"kick","comment":"--- INDIVIDUAL INSTRUMENTS ---"}*/ s("bd*4")), percussion, bass, chords, (/*@odm-pattern {"label":"vocalChop","comment":"1. Chopped & pitched rhythmic vocal hook for the drops"}*/ s("speech:0 speech:2 speech:4 speech:1").struct("~ x ~ x ~ [x x] ~ x").speed(1.25).cut(1).cutoff(2800).delay(0.375).delayfeedback(0.4).room(0.5).gain(0.85))));
$: /*@odm-voice {"name":"$","muted":false}*/ (/*@odm-pattern {"comment":"--- FULL ARRANGEMENT (28 Bars Total) ---"}*/ arrange([4, (/*@odm-pattern {"label":"intro","comment":"1. Intro: Filtered chords and minimal percussion (4 bars)"}*/ stack(percussion.cutoff(1200), chords.cutoff(600)))], [4, (/*@odm-pattern {"label":"buildSection","comment":"2. Build-up: Atmospheric vocal + rising snare roll & filter sweep (4 bars)"}*/ stack(vocalPhrase, s("cp*8").gain(saw.range(0.2, 0.9).slow(4)), chords.cutoff(saw.range(300, 4000).slow(4)), bass.cutoff(250)))], [8, drop], [4, (/*@odm-pattern {"label":"breakdown","comment":"4. Breakdown: Drums drop out; atmospheric vocal + melodic synth (4 bars)"}*/ stack(vocalPhrase, chords.room(0.8), note("g4 ~ eb4 c4 ~ d4 eb4 g4").s("triangle").delay(0.375).gain(0.4)))], [8, drop]));
