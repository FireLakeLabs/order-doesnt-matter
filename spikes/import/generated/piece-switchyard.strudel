setcpm(35.5);
const drums = (/*@odm-pattern {"label":"drums"}*/ stack(s("bd*4"), s("hh*16").gain(0.22).pan(0.65), s("~ cp ~ cp").gain(0.5)));
const bass = (/*@odm-pattern {"label":"bass"}*/ note("g1 g2 bb1 d2").s("sawtooth").cutoff(700).gain(0.45).release(0.12));
const pad = (/*@odm-pattern {"label":"pad"}*/ note("[g3,bb3,d4] [eb3,g3,bb3]").s("triangle").slow(4).gain(0.23).FX(coarse(3), bandf(1200), distort(0.4)));
const lead = (/*@odm-pattern {"label":"lead"}*/ note("<g1 d2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3));
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
