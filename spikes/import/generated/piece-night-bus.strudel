setcpm(28);
const drums = stack(s("bd ~ bd [~ bd]"), s("hh*16").gain(0.22).pan(0.65), s("~ cp ~ cp").gain(0.5));
const bass = note("f2 ab2 c3 eb3").s("triangle").cutoff(700).gain(0.45).release(0.12);
const pad = note("[f3,ab3,c4] [eb3,g3,bb3]").s("triangle").slow(4).gain(0.23).delay(0.4);
const lead = note("<f2 eb3>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3);
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
