setcpm(15);
const drums = (/*@odm-pattern {"label":"drums"}*/ stack(s("bd ~ ~ ~"), s("hh*4").gain(0.22).pan(0.65), s("~ ~ cp ~").gain(0.5)));
const bass = (/*@odm-pattern {"label":"bass"}*/ note("eb2 ~ bb2 ~").s("sine").cutoff(700).gain(0.45).release(0.12));
const pad = (/*@odm-pattern {"label":"pad"}*/ note("[eb4,g4,bb4] [db4,f4,ab4]").s("triangle").slow(4).gain(0.23).room(0.8).release(2));
const lead = (/*@odm-pattern {"label":"lead"}*/ note("<eb2 ~>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3));
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
