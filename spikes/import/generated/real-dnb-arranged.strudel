setcpm(43.5);
const vocalIntro = (/*@odm-pattern {"label":"vocalIntro","comment":"1. Pitched-down atmospheric vocal phrase for the intro & breakdown"}*/ s("ade:1").slow(4).speed(0.85).cutoff(2200).room(0.9).roomsize(0.95).delay(0.375).gain(0.8));
const dnbDrums = (/*@odm-pattern {"label":"dnbDrums","comment":"Classic syncopated 2-step DnB beat"}*/ stack(s("bd ~ ~ ~ ~ bd ~ ~").shape(0.35), s("~ ~ sd ~ ~ ~ sd ~").room(0.25).gain(0.95), s("hh*8").gain(perlin.range(0.4, 0.75)), s("~ ~ ~ hh ~ ~ hh ~").s("oh").gain(0.4)));
const reeseBass = (/*@odm-pattern {"label":"reeseBass","comment":"Gritty, growling Reese bassline"}*/ note("<c1 ~ [eb1 d1] ~ f1 ~ [g1 bb1] ~>").s("sawtooth").cutoff(sine.range(180, 650).slow(2)).resonance(6).shape(0.55).gain(0.95));
const darkPad = (/*@odm-pattern {"label":"darkPad","comment":"Dark, eerie minor pad"}*/ note("<[c3,eb3,g3,d4] [ab2,eb3,g3,c4]>").slow(2).s("supersaw").cutoff(900).attack(0.5).release(1.5).room(0.8).gain(0.45));
const drop = (/*@odm-pattern {"label":"drop","comment":"3. Drop: Full-weight 174 BPM drums, sub/Reese bass, and dub vocal stabs (8 bars)"}*/ stack(dnbDrums, reeseBass, darkPad.cutoff(600), (/*@odm-pattern {"label":"vocalStab","comment":"2. Rapid-fire, chopped ragga/jungle-style vocal stabs for the drop"}*/ s("speech:3 speech:1 speech:5").struct("~ ~ ~ x ~ x ~ [x x]").speed(1.15).cut(1).delay(0.25).delayfeedback(0.55).room(0.4).gain(0.75))));
$: /*@odm-voice {"name":"$","muted":false}*/ (/*@odm-pattern {"comment":"--- FULL ARRANGEMENT (28 Bars Total) ---"}*/ arrange([4, (/*@odm-pattern {"label":"intro","comment":"1. Intro: Atmospheric pad, deep vocal, and high-passed drums (4 bars)"}*/ stack(darkPad, vocalIntro, (/*@odm-pattern {"label":"filteredDrums","comment":"High-passed filtered breakbeat for the intro and build-up"}*/ dnbDrums.hcutoff(saw.range(1200, 300).slow(4)).gain(0.7).hcutoff(1500))))], [4, (/*@odm-pattern {"label":"buildSection","comment":"2. Build-up: Snare roll accelerates while filter opens up (4 bars)"}*/ stack(darkPad, vocalIntro, s("sd*8").gain(saw.range(0.2, 0.9).slow(4)), reeseBass.cutoff(saw.range(100, 300).slow(4))))], [8, drop], [4, (/*@odm-pattern {"label":"breakdown","comment":"4. Breakdown: Drums cut out completely; spacious pads and vocal take over (4 bars)"}*/ stack(darkPad.cutoff(1400), vocalIntro, note("g4 ~ eb4 ~ d4 ~ c4 ~").s("triangle").delay(0.5).room(0.9).gain(0.35)))], [8, drop]));
