setcpm(34.5);
const drums = stack(s("bd*4"), s("[hh hh oh hh]*2").gain(0.22).pan(0.65), s("~ cp ~ cp").gain(0.5));
const bass = note("c2 c2 eb2 gb2").s("sawtooth").cutoff(700).gain(0.45).release(0.12);
const pad = note("[c4,eb4,gb4] ~ [bb3,db4,f4] ~").s("triangle").slow(4).gain(0.23).FX(coarse(4), cutoff(1200), distort(0.5));
const lead = note("<c2 gb2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3);
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
