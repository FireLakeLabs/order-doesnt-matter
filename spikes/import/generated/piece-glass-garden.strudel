setcpm(24);
const drums = (/*@odm-pattern {"label":"drums"}*/ stack(s("bd ~ bd ~"), s("hh*8").gain(0.22).pan(0.65), s("~ cp ~ cp").gain(0.5)));
const bass = (/*@odm-pattern {"label":"bass"}*/ note("b1 fs2 a2 d2").s("sine").cutoff(700).gain(0.45).release(0.12));
const pad = (/*@odm-pattern {"label":"pad"}*/ note("[b3,d4,fs4] [a3,cs4,e4]").s("triangle").slow(4).gain(0.23).FX(phaserrate(0.3), delay(0.2)).room(0.5));
const lead = (/*@odm-pattern {"label":"lead"}*/ note("<b1 d2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3));
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
