setcpm(31);
const drums = (/*@odm-pattern {"label":"drums"}*/ stack(s("bd*4"), s("hh*8").gain(0.22).pan(0.65), s("~ cp ~ cp").gain(0.5)));
const bass = (/*@odm-pattern {"label":"bass"}*/ note("e2 e2 g2 b2").s("sawtooth").cutoff(700).gain(0.45).release(0.12));
const pad = (/*@odm-pattern {"label":"pad"}*/ note("[e4,g4,b4] [d4,fs4,a4]").s("triangle").slow(4).gain(0.23).FX(cutoff(1800), distort(0.3)));
const lead = (/*@odm-pattern {"label":"lead"}*/ note("<e2 b2>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3));
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
