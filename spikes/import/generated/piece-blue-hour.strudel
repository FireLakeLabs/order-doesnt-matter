setcpm(18);
const drums = (/*@odm-pattern {"label":"drums"}*/ stack(s("bd ~ ~ bd"), s("hh*8").gain(0.22).pan(0.65), s("~ cp ~ ~").gain(0.5)));
const bass = (/*@odm-pattern {"label":"bass"}*/ note("bb1 f2 ab2 c3").s("sine").cutoff(700).gain(0.45).release(0.12));
const pad = (/*@odm-pattern {"label":"pad"}*/ note("[bb3,db4,f4] [ab3,c4,eb4]").s("triangle").slow(4).gain(0.23).release(0.8).room(0.6));
const lead = (/*@odm-pattern {"label":"lead"}*/ note("<bb1 c3>").add(note(24)).s("sine").ply("<1 2 3 2>").gain(0.18).delay(0.3));
$: /*@odm-voice {"name":"$","muted":false}*/ arrange([4, drums], [8, stack(drums, bass)], [16, stack(drums, bass, pad, lead)], [4, stack(pad, lead)]);
